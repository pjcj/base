brew "vale"
# Pager/text based browser
brew "w3m"
# C++ search engine library
brew "xapian"
# Linter for YAML files
brew "yamllint"
# JavaScript package manager
brew "yarn"
# UNIX shell (command interpreter)
brew "zsh"
