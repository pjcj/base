brew "c-ares"
# XML-based font configuration API for X Windows
brew "fontconfig"
# Core application library for C
brew "glib"
# Fix common misspellings in source code and text files
brew "codespell"
# Get, unpack, build, and install modules from CPAN
brew "cpanminus"
