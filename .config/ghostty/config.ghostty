# cmux-only Ghostty overrides, layered over `config` in this directory.
# Ghostty reads only `config`. Run `cmux reload-config` after editing.

# cmux.json magnifies every terminal by 120%, so 14 renders at 16.8. The
# shared 17 would give 20.4.
font-size = 14

# The shared 0.5 is too dark.
unfocused-split-opacity = 0.85

# cmux draws the pane border over the terminal, so without padding the
# first line and column sit under it.
window-padding-x = 12,12
window-padding-y = 12,0
