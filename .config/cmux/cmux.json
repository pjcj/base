{
  "$schema": "https://raw.githubusercontent.com/manaflow-ai/cmux/main/web/data/cmux.schema.json",
  "schemaVersion": 1,

  // Pane dividers match .tmux.conf pane-border-style (brightgreen, which the
  // Ghostty palette maps to #586e75) and pane-active-border-style.
  "paneBorderColor": "#586e75",
  "activePaneBorderColor": "#fff179",

  "app": {
    "appearance": "dark",
    // Ghostty config sets quit-after-last-window-closed and
    // confirm-close-surface = false, so do not ask on the way out.
    "confirmQuit": "never",
    "warnBeforeClosingTab": false
  },

  "terminal": {
    // Ghostty config sets copy-on-select = clipboard. cmux defaults to false
    // and suppresses it, so turn it back on here.
    "copyOnSelect": true
  },

  "sidebarAppearance": {
    // #012028 is the background .tmux.conf gives inactive panes, against
    // #001920 for the active one. Reusing it here puts the sidebar in the
    // same visual language. Set matchTerminalBackground true instead to
    // have the sidebar share the terminal background exactly.
    "matchTerminalBackground": false,
    "tintColor": "#012028",
    "tintOpacity": 1
  },

  "notifications": {
    "agentPermissionPrompt": true,
    "agentTurnComplete": "whenIdle",
    "agentIdleReminder": true,
    // cmux runs on its own aerospace workspace, so a sound is the only cue
    // that reaches you while you work in Ghostty. Set "none" to silence it.
    "sound": "Tink"
  },

  "workspaceColors": {
    // Every colour here comes from .config/nvim/lua/solarized_palette.lua,
    // named in the trailing comments. The whole set is listed because cmux
    // replaces this key rather than merging into it. Work and OS match the
    // pane border colours claude-show uses in tmux.
    "colors": {
      "Red": "#dc322f",      // red
      "Crimson": "#64110f",  // mred
      "Orange": "#cb4b16",   // orange
      "Amber": "#b58900",    // yellow
      "Olive": "#859900",    // green
      "Green": "#25ad2e",    // rgreen
      "Teal": "#04746c",     // dcyan
      "Aqua": "#2aa198",     // cyan
      "Blue": "#268bd2",     // blue
      "Navy": "#023458",     // ddblue
      "Indigo": "#323799",   // dviolet
      "Purple": "#6c71c4",   // violet
      "Magenta": "#d33682",  // magenta
      "Rose": "#d37b79",     // lmred
      "Brown": "#7d2500",    // dorange
      "Charcoal": "#0e3c49", // base05
      "Work": "#ffcdcc",     // llllred
      "OS": "#c9f5cc"        // lllgreen
    }
  },

  "automation": {
    "claudeCodeIntegration": true,
    // Route every claude cmux starts through nono. cmux injects its hook
    // arguments before it resolves this path, so the sandbox sees them.
    "claudeBinaryPath": "/Users/pjcj/g/local_base/utils/cmux-claude"
  }
}
