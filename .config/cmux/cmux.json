{
  "$schema": "https://raw.githubusercontent.com/manaflow-ai/cmux/main/web/data/cmux.schema.json",
  "schemaVersion": 1,

  // Pane dividers match .tmux.conf pane-border-style (brightgreen, which the
  // Ghostty palette maps to #586e75) and pane-active-border-style.
  "paneBorderColor": "#586e75",
  "activePaneBorderColor": "#fff179",

  "app": {
    "appearance": "dark",
    // The only text-size control cmux has. It scales the sidebar, but also
    // terminals, tab titles and the rest of the app chrome. Steps of 10 only,
    // from 50 to 200.
    "globalFontMagnification": 120,
    // Ghostty config sets quit-after-last-window-closed and
    // confirm-close-surface = false, so do not ask on the way out.
    "confirmQuit": "never",
    "warnBeforeClosingTab": false
  },

  "terminal": {
    // Ghostty config sets copy-on-select = clipboard. cmux defaults to false
    // and suppresses it, so turn it back on here.
    "copyOnSelect": true
  },

  "sidebar": {
    // Wrap workspace titles over several lines rather than truncating them
    // after one.
    "wrapWorkspaceTitles": true
  },

  "sidebarAppearance": {
    // #012028 is the background .tmux.conf gives inactive panes, against
    // #001920 for the active one. Reusing it here puts the sidebar in the
    // same visual language. Set matchTerminalBackground true instead to
    // have the sidebar share the terminal background exactly.
    "matchTerminalBackground": false,
    "tintColor": "#012028",
    "tintOpacity": 1
  },

  "notifications": {
    "agentPermissionPrompt": true,
    "agentTurnComplete": "whenIdle",
    "agentIdleReminder": true,
    // cmux runs on its own aerospace workspace, so a sound is the only cue
    // that reaches you while you work in Ghostty. Set "none" to silence it.
    "sound": "Tink"
  },

  "workspaceColors": {
    // Every colour here comes from .config/nvim/lua/solarized_palette.lua,
    // named in the trailing comments. The whole set is listed because cmux
    // replaces this key rather than merging into it. Work and OS match the
    // pane border colours claude-show uses in tmux.
    "colors": {
      "Red": "#dc322f",      // red
      "Crimson": "#64110f",  // mred
      "Orange": "#cb4b16",   // orange
      "Amber": "#b58900",    // yellow
      "Olive": "#859900",    // green
      "Green": "#25ad2e",    // rgreen
      "Teal": "#04746c",     // dcyan
      "Aqua": "#2aa198",     // cyan
      "Blue": "#268bd2",     // blue
      "Navy": "#023458",     // ddblue
      "Indigo": "#323799",   // dviolet
      "Purple": "#6c71c4",   // violet
      "Magenta": "#d33682",  // magenta
      "Rose": "#d37b79",     // lmred
      "Brown": "#7d2500",    // dorange
      "Charcoal": "#0e3c49", // base05
      "Work": "#ffcdcc",     // llllred
      "OS": "#c9f5cc"        // lllgreen
    }
  },

  "automation": {
    "claudeCodeIntegration": true,
    // Route every claude cmux starts through nono. cmux injects its hook
    // arguments before it resolves this path, so the sandbox sees them.
    "claudeBinaryPath": "/Users/pjcj/g/local_base/utils/cmux-claude"
  },

  "shortcuts": {
    // Two problems drove this. cmux binds 14 actions to [ and ], which on a
    // Swiss German keyboard need Option to type at all, so they cannot be
    // reached with Command or Control held. And pane focus shipped on
    // opt+cmd with the arrows, where opt+cmd+h is the macOS Hide Others
    // shortcut and something takes opt+cmd+left as well.
    //
    // So everything lives on ctrl+cmd and hjkl instead. Nothing collides
    // with nvim, tmux or aerospace, none of which use Command. Plain
    // ctrl+hjkl stays free, so smart-splits keeps working in nvim.
    //
    // hjkl means direction, so pane focus takes the plain group. Workspaces
    // are a vertical list and tabs a horizontal strip, so those two share a
    // group, k and j for one and h and l for the other. Adding opt means
    // move the thing rather than move to it.
    "bindings": {
      "focusLeft": "ctrl+cmd+h",
      "focusDown": "ctrl+cmd+j",
      "focusUp": "ctrl+cmd+k",
      "focusRight": "ctrl+cmd+l",

      "prevSidebarTab": "ctrl+cmd+shift+k",
      "nextSidebarTab": "ctrl+cmd+shift+j",
      "prevSurface": "ctrl+cmd+shift+h",
      "nextSurface": "ctrl+cmd+shift+l",

      "moveWorkspaceUp": "ctrl+opt+cmd+k",
      "moveWorkspaceDown": "ctrl+opt+cmd+j",
      "moveSurfaceLeft": "ctrl+opt+cmd+h",
      "moveSurfaceRight": "ctrl+opt+cmd+l",

      "moveSurfaceToPreviousPane": "ctrl+opt+cmd+shift+h",
      "moveSurfaceToNextPane": "ctrl+opt+cmd+shift+l",

      // Back and forward share their keys, as they do by default, because
      // cmux picks between them by context. Focus history walks the
      // workspaces you have visited, browser history the pages.
      "focusHistoryBack": "ctrl+opt+cmd+shift+k",
      "focusHistoryForward": "ctrl+opt+cmd+shift+j",
      "browserBack": "ctrl+opt+cmd+shift+k",
      "browserForward": "ctrl+opt+cmd+shift+j"
    }
  }
}
