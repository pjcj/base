{
  "$schema": "https://raw.githubusercontent.com/manaflow-ai/cmux/main/web/data/cmux.schema.json",
  "schemaVersion": 1,

  // Matches pane-border-style and pane-active-border-style in .tmux.conf.
  "paneBorderColor": "#586e75",
  "activePaneBorderColor": "#fff179",

  "app": {
    "appearance": "dark",
    // Scales the whole app, not the sidebar alone. config.ghostty offsets it.
    "globalFontMagnification": 120,
    // Ghostty config already skips both confirmations.
    "confirmQuit": "never",
    "warnBeforeClosingTab": false
  },

  "terminal": {
    // cmux defaults this off, suppressing Ghostty's copy-on-select.
    "copyOnSelect": true
  },

  "sidebar": {
    "wrapWorkspaceTitles": true,
    // Off until cmux prunes dead ports - stale test-server ports pile up.
    "showPorts": false
  },

  "sidebarAppearance": {
    // #012028 is the inactive pane background .tmux.conf uses.
    "matchTerminalBackground": false,
    "tintColor": "#012028",
    "tintOpacity": 1
  },

  "notifications": {
    "agentPermissionPrompt": true,
    "agentTurnComplete": "whenIdle",
    "agentIdleReminder": true,
    // cmux sits on its own aerospace workspace, so sound is the only cue.
    "sound": "Tink"
  },

  "workspaceColors": {
    // base05. The default is the macOS accent blue, garish beside solarized.
    "selectionColor": "#0e3c49",

    // Names from solarized_palette.lua. cmux replaces this key, not merges.
    "colors": {
      "Red": "#dc322f",      // red
      "Crimson": "#64110f",  // mred
      "Orange": "#cb4b16",   // orange
      "Amber": "#b58900",    // yellow
      "Olive": "#859900",    // green
      "Green": "#25ad2e",    // rgreen
      "Teal": "#04746c",     // dcyan
      "Aqua": "#2aa198",     // cyan
      "Blue": "#268bd2",     // blue
      "Navy": "#023458",     // ddblue
      "Indigo": "#323799",   // dviolet
      "Purple": "#6c71c4",   // violet
      "Magenta": "#d33682",  // magenta
      "Rose": "#d37b79",     // lmred
      "Brown": "#7d2500",    // dorange
      "Charcoal": "#0e3c49", // base05
      "Work": "#ffcdcc",     // llllred
      "OS": "#c9f5cc"        // lllgreen
    }
  },

  "automation": {
    "claudeCodeIntegration": true,
    // Routes claude through nono. cmux injects its hook arguments first.
    "claudeBinaryPath": "/Users/pjcj/g/local_base/utils/cmux-claude"
  },

  "actions": {
    // claude, not nclaude. The cmux shim already routes it through nono.
    "claude": {
      "type": "command",
      "title": "Claude Code",
      "subtitle": "Start claude in a new tab",
      "command": "claude --chrome",
      "target": "newTabInCurrentPane",
      "shortcut": "ctrl+cmd+a"
    },

    // currentTerminal, so the script inherits the pane's directory. It
    // needs a shell prompt, unlike the newTabInCurrentPane action above.
    "claude-pane": {
      "type": "command",
      "title": "Claude Pane",
      "subtitle": "Start claude in a 40% pane on the right",
      "command": "cmux-pane-claude",
      "target": "currentTerminal",
      "shortcut": "ctrl+cmd+shift+a"
    }
  },

  "shortcuts": {
    // [ and ] need Option on a Swiss German keyboard. ctrl+cmd is free.
    "bindings": {
      "focusLeft": "ctrl+cmd+h",
      "focusDown": "ctrl+cmd+j",
      "focusUp": "ctrl+cmd+k",
      "focusRight": "ctrl+cmd+l",

      "prevSidebarTab": "ctrl+cmd+shift+k",
      "nextSidebarTab": "ctrl+cmd+shift+j",
      "prevSurface": "ctrl+cmd+shift+h",
      "nextSurface": "ctrl+cmd+shift+l",

      "moveWorkspaceUp": "ctrl+opt+cmd+k",
      "moveWorkspaceDown": "ctrl+opt+cmd+j",
      "moveSurfaceLeft": "ctrl+opt+cmd+h",
      "moveSurfaceRight": "ctrl+opt+cmd+l",

      "moveSurfaceToPreviousPane": "ctrl+opt+cmd+shift+h",
      "moveSurfaceToNextPane": "ctrl+opt+cmd+shift+l",

      // Shared keys, as by default. cmux picks between them by context.
      "focusHistoryBack": "ctrl+opt+cmd+shift+k",
      "focusHistoryForward": "ctrl+opt+cmd+shift+j",
      "browserBack": "ctrl+opt+cmd+shift+k",
      "browserForward": "ctrl+opt+cmd+shift+j"
    }
  }
}
