#!/usr/bin/env perl

package MusicSync;

use 5.28.0;
use warnings;
use utf8;
use feature "signatures";
no warnings "experimental::signatures";
use open qw( :std :utf8 );

use Encode       qw( decode_utf8 );
use FindBin      ();
use Getopt::Long qw( GetOptionsFromArray );
use lib "$FindBin::RealBin/../lib";

use MusicSync::Duplicates qw( list_duplicates mark_duplicates report_marks );
use MusicSync::Playlists  qw( export_playlists list_playlists pull_playlists
  push_playlists report );
use MusicSync::Plex    qw( default_section default_server plex_client );
use MusicSync::Ratings qw( merge_ratings pull_ratings push_ratings
  report_ratings );
use MusicSync::Strawberry qw( default_db open_db );

sub usage () {
  my $server  = default_server();
  my $section = default_section();
  <<~TEXT
  Usage: music_sync NOUN VERB [options]

  Commands:
    playlists pull      Copy Plex playlists into Strawberry (quit it first)
    playlists push      Update Plex playlists from Strawberry
    playlists export    Write playlists and their files to a device folder
    playlists list      Show the playlists on both sides
    ratings pull        Take higher ratings from Plex (quit Strawberry first)
    ratings push        Send higher ratings to Plex
    ratings merge       Raise ratings on both sides to the higher
    duplicates list     Show the copies of each recording and the winner
    duplicates mark     Give the losing copies one star (quit Strawberry first)

  Options:
    --server NAME|URL   Plex server name or URL, defaults to $server
    --token TOKEN       Plex token
    --username EMAIL    Plex account, prompts for the password
    --password PASS     Plex password
    --db PATH           Strawberry database, defaults to the real one
    --dir PATH          Export folder (export only)
    --plex-root PATH    Library root on the Plex server, detected if absent
    --local-root PATH   Collection folder Plex mirrors, detected if absent
    --user ID           Plex home user whose playlists and ratings to use
    --section NAME      Plex music section to match, defaults to $section
    --playlist NAME     Limit to this playlist, repeatable
    --smart             Include smart playlists, export signs in to Plex
    --overwrite         Take every rating from the source, not just higher
    --flac              Push every entry as FLAC where Plex has one
    --mp3               Push every entry as MP3
    --dry-run           Report without changing anything
    --debug             Show each Plex request
    --help              Show this help

  Only Strawberry playlists saved to the sidebar take part.
  TEXT
}

sub smart_client ($opts) { $opts->{smart} ? plex_client($opts) : undef }

my $Command = {
  playlists => {
    list => sub ($opts) {
      list_playlists(plex_client($opts), open_db($opts->{db}));
    },
    pull => sub ($opts) {
      my $dbh = open_db($opts->{db}, !$opts->{dry_run});
      report(pull_playlists(plex_client($opts), $dbh, $opts), $opts);
    },
    push => sub ($opts) {
      my $dbh = open_db($opts->{db});
      report(push_playlists(plex_client($opts), $dbh, $opts), $opts);
    },
    export => sub ($opts) {
      die "Use --dir to name the export folder\n" unless $opts->{dir};
      my $dbh  = open_db($opts->{db});
      my $plex = smart_client($opts);
      report(export_playlists($dbh, $opts->{dir}, $opts, $plex), $opts);
    },
  },
  ratings => {
    pull => sub ($opts) {
      my $dbh = open_db($opts->{db}, !$opts->{dry_run});
      report_ratings(pull_ratings(plex_client($opts), $dbh, $opts), $opts);
    },
    push => sub ($opts) {
      my $dbh = open_db($opts->{db});
      report_ratings(push_ratings(plex_client($opts), $dbh, $opts), $opts);
    },
    merge => sub ($opts) {
      my $dbh = open_db($opts->{db}, !$opts->{dry_run});
      report_ratings(merge_ratings(plex_client($opts), $dbh, $opts), $opts);
    },
  },
  duplicates => {
    list => sub ($opts) {
      list_duplicates(plex_client($opts), open_db($opts->{db}), $opts);
    },
    mark => sub ($opts) {
      my $dbh = open_db($opts->{db}, !$opts->{dry_run});
      report_marks(mark_duplicates(plex_client($opts), $dbh, $opts), $opts);
    },
  },
};

sub run ($opts) {
  return print usage() if $opts->{help};
  $Command->{ $opts->{noun} }{ $opts->{verb} }->($opts)
}

sub parse_options ($argv) {
  my $opts = { playlists => [], db => default_db() };
  GetOptionsFromArray(
    $argv,
    "server=s"     => \$opts->{server},
    "token=s"      => \$opts->{token},
    "username=s"   => \$opts->{username},
    "password=s"   => \$opts->{password},
    "db=s"         => \$opts->{db},
    "dir=s"        => \$opts->{dir},
    "plex-root=s"  => \$opts->{plex_root},
    "local-root=s" => \$opts->{local_root},
    "user=s"       => \$opts->{user},
    "section=s"    => \$opts->{section},
    "playlist=s"   => $opts->{playlists},
    "smart"        => \$opts->{smart},
    "overwrite"    => \$opts->{overwrite},
    "flac"         => \$opts->{flac},
    "mp3"          => \$opts->{mp3},
    "dry-run"      => \$opts->{dry_run},
    "debug"        => \$opts->{debug},
    "help"         => \$opts->{help}
  ) or die usage();
  return $opts                             if $opts->{help};
  die "Use only one of --flac and --mp3\n" if $opts->{flac} && $opts->{mp3};
  for my $key (qw( plex_root local_root )) {
    my $root = \$opts->{$key};
    $$root .= "/" if defined $$root && $$root =~ m|[^/]$|;
  }
  $opts->{noun} = shift @$argv // die usage();
  $opts->{verb} = shift @$argv // die usage();
  die usage() unless ($Command->{ $opts->{noun} } // {})->{ $opts->{verb} };
  die "ratings merge takes no --overwrite\n"
    if $opts->{overwrite} && $opts->{verb} eq "merge";
  $opts
}

sub main () {
  local @ARGV = map decode_utf8($_), @ARGV;
  run(parse_options(\@ARGV));
}

main() unless caller;

1;

__END__

=head1 NAME

music_sync - copy playlists and ratings between Plex, Strawberry and devices

=head1 SYNOPSIS

 music_sync playlists pull   --username EMAIL [--smart] [--playlist NAME]...
 music_sync playlists push   --username EMAIL [--flac|--mp3]
                             [--section NAME] [--playlist NAME]...
 music_sync playlists export --dir PATH [--smart --username EMAIL]
                             [--playlist NAME]...
 music_sync playlists list   --username EMAIL
 music_sync ratings pull     --username EMAIL [--overwrite]
 music_sync ratings push     --username EMAIL [--overwrite]
 music_sync ratings merge    --username EMAIL
 music_sync duplicates list  --username EMAIL [--section NAME]
 music_sync duplicates mark  --username EMAIL [--section NAME] [--dry-run]

=head1 DESCRIPTION

Plex and Strawberry each keep their own playlists and ratings. This script
copies playlists in either direction, writes them out for portable players,
moves ratings both ways and finds the copies of one recording, so that one
copy wins and the rest drop out of the way.

The script signs in to plex.tv with C<--username> and C<--password>, or uses
C<--token>. It then asks plex.tv for the servers of that account and connects
to the one called Wezflix, or to the one C<--server> names. It prefers a
direct connection over the internet, then one on the LAN, then the Plex
relay. Give C<--server> a URL to skip the lookup.

C<playlists pull> writes every audio playlist on the Plex server into the
Strawberry database as a favourite playlist, in Plex order, replacing the
items of a playlist that already exists. Strawberry reads its playlists only
at startup and overwrites the database whenever a playlist changes, so pull
stops with an error while Strawberry is open. It skips smart playlists,
unless C<--smart> pulls each one as a plain playlist holding its tracks at
the time.

C<playlists push> makes each Plex playlist match the Strawberry favourite of
the same name by removing, adding and moving items, and creates playlists
Plex lacks. It reads the database only, so Strawberry may stay open.

With C<--user> the script acts as that Plex home user, so the playlists and
ratings it reads and writes are theirs rather than those of the account that
signs in.

C<playlists export> copies the files of each favourite playlist into a
folder, once per file at the path the collection uses, and writes one M3U8
playlist per favourite at the top of the folder with entries relative to it.
It removes files and playlists no longer wanted, unless C<--playlist> narrows
the export. With C<--smart> it also signs in to Plex and writes each smart
playlist beside the favourites, as it stands at the time, so a smart playlist
named like a favourite replaces its file. Copy the folder as it is into the
Music folder of a Garmin watch or into a scanned folder on a phone.

A smart playlist built on ratings lists every copy of a recording, since
the copies share one rating. With C<--smart>, pull and export leave out the
losing copies that L</DUPLICATES> describes and keep the winner, which
costs one listing of the section per run.

Neither direction deletes a playlist. Only Strawberry playlists saved to the
sidebar take part, since Strawberry deletes open tabs when they close.

=head1 RATINGS

Plex rates a track from 0 to 10, two points per star, and Strawberry from 0
to 1, 0.2 per star. The script compares on the Plex scale and converts both
ways, so half stars survive.

C<ratings pull> gives each Strawberry song the Plex rating of its track when
that is higher, and C<ratings push> gives each Plex track the Strawberry
rating when that is higher. C<ratings merge> does both, so the higher rating
wins on each side and a second run has nothing to do. C<--overwrite> takes
every rating from the source on a pull or a push instead. An unrated track
never clears a rating on the other side. Only tracks in the chosen section
that match a collection song take part. Pull and merge write the database,
so quit Strawberry first. Push only reads it.

All three leave the losing copies of a duplicate group alone, as
L</DUPLICATES> describes. Pull never raises one and push never sends from
one, so the rating a group shares in Plex reaches the winner only and a one
star mark in Strawberry never goes back to Plex.

Lowering a rating on one side does not carry, since the next default run
restores the higher one. Use C<ratings pull --overwrite> to make Plex the
authority after such a change.

=head1 DUPLICATES

Tracks that the Plex agent matched to one recording share a guid. A
recording ripped from a single and again from a compilation therefore has
two copies with one rating between them. C<duplicates list> groups the
tracks of the section by guid and names a winner in each group, the copy to
keep. An MP3 converted from FLAC under C<t/f/> beats one under C<t/m/>.
Among C<t/m/> files a higher bitrate band wins, with the bands split at 112,
176 and 240 kbps. After that an original album beats the artist's own
compilation, which beats a Various Artists one, and then the earlier album,
the higher bitrate, the larger file and the path decide in turn. A group
whose copies differ in length by more than five seconds, or whose titles
share too few words, is in doubt. The list reports it for a look by hand. A
group decided by the path alone is one album ripped twice into two folders.

After the groups the list reports pairs of tracks with different guids but
the same artist and title within three seconds of each other. These may be
one recording the agent matched twice or not at all, so they are reported
in three bands, same album, a local guid on one side, and both in the
catalogue, and nothing marks them.

C<duplicates mark> gives every loser of a group not in doubt one star in
Strawberry, so that it drops out of playlists built on ratings while the
winner keeps the shared Plex rating. It writes the database, so quit
Strawberry first. A loser already at one star is left alone, and so is a
loser with no local file. Run it again after new rips, since the groups come
from Plex each time.

=head1 MATCHING

A Strawberry item and a Plex track are the same when their paths relative to
their library roots match, compared in Unicode NFC form. The Plex root is
the server side path above the library, and the local root is the folder of
the Strawberry collection that mirrors it, which may be the collection root
itself. Unless C<--plex-root> and C<--local-root> give them, the script
detects both from the pair of files, one on each side, with the longest
trailing path in common. A file name that a cover shares with its original
therefore cannot mislead it. Every report starts with the roots in use. The
script lists and skips tracks with no match.

C<playlists push> and the ratings commands match against the tracks of one
Plex music section, C<mp3> unless C<--section> names another, since a file
that two sections share has a different key in each.

=head1 FORMATS

The server holds each ripped CD twice, as FLAC under C<flac-tagged/> and as
MP3 under C<t/f/>, both relative to the library root, while the collection
holds only the MP3s. MP3s under C<t/m/> have no FLAC. Pull matches a FLAC
entry to its MP3 and writes a track once however often the Plex playlist
repeats it. Push keeps the format each Plex entry already has and adds new
entries as FLAC where Plex has one. C<--flac> makes every entry FLAC where
possible and C<--mp3> makes every entry MP3.

