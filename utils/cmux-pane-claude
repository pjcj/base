#!/usr/bin/env bash

# Open claude in a pane beside the current cmux pane, in the requested
# mode or the one claude-mode picks for the directory.
#
# The cmux counterpart of claude-show, which does the same job in tmux.
# A cmux action in ~/.config/cmux/cmux.json types this command into the
# focused terminal, so $PWD is the pane it was run from.
#
# cmux splits at half width and offers no ratio when splitting, so the
# width is set afterwards through the pane.resize RPC, which the
# resize-pane command does not expose.
#
# The pane is as tall as the pane it was split from, so it fills the
# height unless that pane was already part of a vertical split.

set -eEuo pipefail
shopt -s inherit_errexit 2>/dev/null || true

readonly Width_percent=35

usage() {
  cat <<EOF
Usage: cmux-pane-claude [MODE]

Open claude in a pane beside the current cmux pane, taking
${Width_percent}% of the workspace width.

Modes:
  default   The account claude-mode picks for the directory.
  work      claude-work, titled claude-work.
  os        claude-os, titled claude-os.

Options:
  -h, --help   Show this help and exit.

Bound to the claude-pane action in ~/.config/cmux/cmux.json.
EOF
}

die() {
  echo "cmux-pane-claude: $1" >&2
  exit 1
}

pane_holding() {
  local panes="$1" surface="$2"
  jq -r --arg surface "$surface" \
    '.panes[] | select(.surface_refs | index($surface)) | .ref' <<<"$panes"
}

pane_width() {
  local panes="$1" width
  width=$(jq ".container_frame.width * $Width_percent / 100" <<<"$panes")
  [[ $width != 0 ]] || die "this workspace is not the visible one"
  echo "$width"
}

resize_pane() {
  local workspace="$1" pane="$2" width="$3"
  cmux rpc pane.resize "{\"workspace_id\": \"$workspace\",
    \"pane_id\": \"$pane\", \"absolute_axis\": \"horizontal\",
    \"target_pixels\": $width}" >/dev/null
}

claude_command() {
  local mode="$1" quoted_dir claude_cmd
  printf -v quoted_dir %q "$PWD"
  printf -v claude_cmd 'zsh -ic %q' \
    "cd $quoted_dir && CLAUDE_MODE=$mode claude --chrome"
  echo "$claude_cmd"
}

resolve_mode() {
  local requested="$1"
  if [[ -z $requested || $requested == default ]]; then
    claude-mode --print
  else
    claude-mode --print "$requested"
  fi
}

title_for() {
  local mode="$1"
  if [[ $mode == default ]]; then
    echo claude
  else
    echo "claude-$mode"
  fi
}

main() {
  case "${1:-}" in
  -h | --help)
    usage
    return 0
    ;;
  "") ;;
  *)
    echo "cmux-pane-claude: unknown argument '$1'" >&2
    usage >&2
    return 2
    ;;
  esac

  command -v cmux >/dev/null || die "cmux is not installed"
  command -v jq >/dev/null || die "jq is not installed"
  command -v claude-mode >/dev/null || die "claude-mode is not installed"
  export CMUX_QUIET=1

  local mode title
  mode=$(resolve_mode "${1:-}")
  title=$(title_for "$mode")

  local reply surface workspace
  reply=$(cmux new-split right --focus true) ||
    die "could not split the pane, is this a cmux terminal?"
  read -r _ surface workspace <<<"$reply"

  local panes pane width claude_cmd
  panes=$(cmux rpc pane.list "{\"workspace_id\": \"$workspace\"}")
  pane=$(pane_holding "$panes" "$surface")
  width=$(pane_width "$panes")
  resize_pane "$workspace" "$pane" "$width"

  claude_cmd=$(claude_command "$mode")
  cmux respawn-pane --workspace "$workspace" --surface "$surface" \
    --command "$claude_cmd" >/dev/null
  cmux rename-tab --workspace "$workspace" --surface "$surface" \
    "$title" >/dev/null
}

main "$@"
